{
  "name": "muco-labs-v1",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsx --tsconfig scripts/tsconfig.json scripts/generate-seo.ts && tsc -b && tsc -p tsconfig.server.json --noEmit && vite build",
    "generate:seo": "tsx --tsconfig scripts/tsconfig.json scripts/generate-seo.ts",
    "dev:api": "tsx watch server/dev.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx server/db/migrate.ts",
    "db:seed": "tsx server/db/seed.ts",
    "test": "vitest run",
    "lint": "oxlint",
    "audit": "npm audit",
    "preview": "vite preview"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.0",
    "@react-three/drei": "^10.7.8",
    "@react-three/fiber": "^9.7.0",
    "@supabase/supabase-js": "^2.112.2",
    "cheerio": "^1.2.0",
    "drizzle-orm": "^0.45.2",
    "framer-motion": "^13.0.0",
    "hono": "^4.13.1",
    "postgres": "^3.4.9",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-icons": "^5.7.0",
    "react-router-dom": "^7.18.2",
    "three": "^0.185.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "@types/pg": "^8.21.0",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@types/three": "^0.185.4",
    "@vitejs/plugin-react": "^6.0.4",
    "drizzle-kit": "^0.31.10",
    "jsdom": "^30.0.1",
    "oxlint": "^1.75.0",
    "tsx": "^4.23.11",
    "typescript": "~6.0.2",
    "vite": "^8.2.0",
    "vitest": "^4.1.10"
  }
}
