# Public site URL (canonical URLs, Open Graph, sitemap, robots)
VITE_SITE_URL=https://www.mucolabs.com

# Future application origin (not used by public site yet)
VITE_APP_URL=https://app.mucolabs.com

# --- Client-visible (VITE_*) — safe for the browser bundle only ---
# Never prefix server secrets (DB, webhooks, signing keys) with VITE_.

# Public API base (optional). Leave empty for same-origin /api on Vercel.
# VITE_API_BASE_URL=

# Contact / lead intake endpoint (defaults to same-origin /api/v1/leads)
# VITE_CONTACT_API_URL=/api/v1/leads

# Optional: Google Analytics 4 measurement ID (G-XXXXXXXXXX)
# VITE_GA_MEASUREMENT_ID=

# Optional: Google Search Console HTML tag verification content value
# VITE_GSC_VERIFICATION=

# Supabase Auth (browser — use JWT anon key for sign-in/sign-up/OAuth via supabase-js)
# VITE_SUPABASE_URL=https://your-project.supabase.co
# Client auth (sign-in, sign-up, OAuth) requires the JWT anon key — not the publishable key.
# VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
# VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...  (optional; ignored for auth when JWT anon is set)

# Optional: base URL for auth email redirects (defaults to current origin in dev)
# VITE_AUTH_REDIRECT_URL=http://localhost:5173

# --- Server-only (never use VITE_ prefix) ---
# PostgreSQL connection string (Neon, Supabase, Vercel Postgres, etc.)
# DATABASE_URL=postgresql://user:password@host:5432/muco
# On Vercel + Supabase integration, POSTGRES_URL / POSTGRES_PRISMA_URL are also accepted server-side.

# Supabase (server — service role for JWT verification and admin invites)
# SUPABASE_URL=https://your-project.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
# Anon/publishable key for server-side MUCO ID password login (same value as VITE publishable key)
# SUPABASE_ANON_KEY=your-anon-or-publishable-key

# Auth email redirect fallbacks (server-side invites)
# AUTH_REDIRECT_URL=https://app.mucolabs.com
# AUTH_INVITE_REDIRECT_URL=https://team.mucolabs.com/auth/reset-password

# One-time founder bootstrap secret (POST /api/v1/admin/bootstrap/founder)
# FOUNDER_BOOTSTRAP_SECRET=

# Future signing secret (additional server crypto if needed)
# AUTH_SECRET=

# Comma-separated browser origins allowed to call the API cross-origin
# Include all portal origins when using split subdomains in production:
# CORS_ORIGINS=https://www.mucolabs.com,https://app.mucolabs.com,https://team.mucolabs.com,https://freelancers.mucolabs.com,https://admin.mucolabs.com

# Optional portal origin overrides (client bundle; defaults in src/config/domains/portal-origins.ts)
# VITE_PORTAL_ORIGIN_CUSTOMER=https://app.mucolabs.com
# VITE_PORTAL_ORIGIN_EMPLOYEE=https://team.mucolabs.com
# VITE_PORTAL_ORIGIN_FREELANCER=https://freelancers.mucolabs.com
# VITE_PORTAL_ORIGIN_ADMIN=https://admin.mucolabs.com

# Optional lead rate limiting (defaults: 5 requests / 60s / IP)
# LEAD_RATE_LIMIT_MAX=5
# LEAD_RATE_LIMIT_WINDOW_MS=60000

# Auth endpoints (defaults: 20 requests / 60s / IP)
# AUTH_RATE_LIMIT_MAX=20
# AUTH_RATE_LIMIT_WINDOW_MS=60000

# Razorpay (server only — never VITE_)
# RAZORPAY_KEY_ID=
# RAZORPAY_KEY_SECRET=
# RAZORPAY_WEBHOOK_SECRET=

# Resend transactional email (server only)
# RESEND_API_KEY=
# RESEND_FROM_EMAIL=MUCO LABS <noreply@mucolabs.com>

# Supabase Storage bucket for customer/employee uploads
# SUPABASE_STORAGE_BUCKET=customer-files

# NVIDIA AI (server only — Website / Solution Intelligence foundation)
# NVIDIA_API_KEY=
# NVIDIA_API_BASE_URL=https://integrate.api.nvidia.com/v1
# NVIDIA_MODEL=meta/llama-3.1-8b-instruct
# NVIDIA_REQUEST_TIMEOUT_MS=30000

# Local API dev server port (npm run dev:api)
# API_PORT=8787

# Website Intelligence (server only)
# PAGESPEED_INSIGHTS_API_KEY=
# WI_MAX_PAGES=15
# WI_MAX_DEPTH=2
# WI_REQUEST_TIMEOUT_MS=15000
# WI_CRAWL_DELAY_MS=500
# WI_USER_AGENT=MUCO-Website-Intelligence/1.0 (+https://mucolabs.com)
